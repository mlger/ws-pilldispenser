root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,json,jsonc}]
indent_style = space
indent_size = 2

[*.{c,h,cpp,hpp,cmake}]
indent_style = space
indent_size = 4

[*.py]
indent_style = space
indent_size = 4

[CMakeLists.txt]
indent_style = space
indent_size = 4

[*.md]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
