# Board-specific defaults: Waveshare ESP32-S3-Touch-LCD-4.3B
# (ESP32-S3-WROOM-1-N16R8: 16 MB flash, 8 MB octal PSRAM).
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# Console on UART0 (the board's UART Type-C port) — never USB-Serial-JTAG,
# which is a stub under QEMU and would boot silent.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
