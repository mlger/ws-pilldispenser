# Board-specific defaults: Waveshare ESP32-S3-Touch-LCD-4.3B
# (ESP32-S3-WROOM-1-N16R8: 16 MB flash, 8 MB octal PSRAM).
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# Console on the native USB Type-C (USB-Serial-JTAG, GPIO19/20): the board
# has no USB-UART bridge and GPIO43/44 belong to the RS485 transceiver
# (verified against the Waveshare demo + wiki, Phase 1). The QEMU leg
# overrides this to UART0 in sdkconfig.qemu — USB-Serial-JTAG is a QEMU stub
# and would boot silent there.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
