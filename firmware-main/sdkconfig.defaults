# PillDispenser common defaults (all legs).
CONFIG_FREERTOS_HZ=1000
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# Table at 0x10000: secure boot v2 bootloaders exceed 0x8000 bytes
# (see partitions.csv header comment).
CONFIG_PARTITION_TABLE_OFFSET=0x10000
CONFIG_COMPILER_OPTIMIZATION_CHECKS_DEBUG=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
