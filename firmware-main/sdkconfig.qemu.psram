# QEMU leg with PSRAM enabled — used only after the Phase 0.5 spike (a)
# proves `-m 8M` octal PSRAM works on the esp32s3 machine.
CONFIG_PD_HAL_SIM=y
CONFIG_PD_SIM_CONSOLE=y
CONFIG_PD_TEST_HOOKS=y
CONFIG_ETH_USE_OPENETH=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_LOG_DEFAULT_LEVEL_DEBUG=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
